# Copy relevant keys into Replit Secrets (not into a committed .env file).
# Every value below is optional -- the system runs fully in SIMULATED mode
# with none of them set.

# --- LLM provider (pick one; Anthropic is preferred if both are set) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
QA_AGENT_MODEL_CHEAP=claude-haiku-4-5
QA_AGENT_MODEL_DEEP=claude-sonnet-4-5
QA_AGENT_OPENAI_MODEL_CHEAP=gpt-4o-mini
QA_AGENT_OPENAI_MODEL_DEEP=gpt-4o

# --- GitHub (Fix Agent / Test Writer Agent draft PRs) ---
GITHUB_TOKEN=
QA_AGENT_GITHUB_REPO=your-org/your-mobile-qa-repo

# --- Jira (Bug Review Agent) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=QA

# --- Slack (Escalation Agent) ---
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#qa-agent-alerts

# --- BrowserStack (Evidence Agent) ---
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# --- Tuning ---
QA_AGENT_MAX_PARALLEL_CLUSTERS=6
QA_AGENT_MAX_REFLEXION_ROUNDS=3
QA_AGENT_REFLEXION_CONFIDENCE_THRESHOLD=0.75
QA_AGENT_SEMANTIC_CACHE_THRESHOLD=0.90
